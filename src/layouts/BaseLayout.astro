---
import '../styles/global.css';

interface Props {
  title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="Panel de evaluación de riesgo de fraude en transacciones." />
    <title>{title}</title>
  </head>
  <body>
    <slot />
  </body>
</html>
